{
    "intelephense.environment.documentRoot": "/var/www/presta8.avalonbg.com",
    "intelephense.environment.includePaths": [
        "/var/www/presta8.avalonbg.com/config",
        "/var/www/presta8.avalonbg.com/classes",
        "/var/www/presta8.avalonbg.com/src",
        "/var/www/presta8.avalonbg.com/vendor",
        "/var/www/presta8.avalonbg.com/var"
    ],
    "intelephense.files.exclude": [
        "**/var/cache/**",
        "**/var/logs/**",
        "**/var/sessions/**"
    ],
    "files.associations": {
        "*.tpl": "smarty"
    },
    "[smarty]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": null
    }
}
